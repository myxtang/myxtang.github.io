---
layout: clean
---
<main class="wrap">
  <header class="intro">
    <h1>
      {{ site.first_name }}
      {{ site.last_name }}
    </h1>
    {% if page.eyebrow %}
      <div class="eyebrow">{{ page.eyebrow }}</div>
    {% endif %}
  </header>

  <section class="block" id="about" aria-label="About">
    <div class="about">
      {% if page.profile.image %}
        {% assign profile_src = page.profile.image | prepend: '/assets/img/' %}
        <img src="{{ profile_src | relative_url | bust_file_cache }}" alt="Portrait of {{ site.first_name }} {{ site.last_name }}">
      {% endif %}
      <div>
        {{ content }}
        <div class="links">
          {% if site.data.socials.email %}
            <a href="mailto:{{ site.data.socials.email | encode_email }}">Email</a>
          {% endif %}
          {% if site.data.socials.github_username %}
            <a href="https://github.com/{{ site.data.socials.github_username }}">GitHub</a>
          {% endif %}
          {% if site.data.socials.scholar_userid %}
            <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}">Scholar</a>
          {% endif %}
          {% if site.data.socials.orcid_id %}
            <a href="https://orcid.org/{{ site.data.socials.orcid_id }}">ORCID</a>
          {% endif %}
          {% if site.data.socials.linkedin_username %}
            <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}">LinkedIn</a>
          {% endif %}
          <a href="{{ '/cv/' | relative_url }}">CV</a>
        </div>
      </div>
    </div>
  </section>

  {% if page.announcements and page.announcements.enabled %}
    <section class="block" id="news">
      <div class="sec-head">
        <h2>News</h2>
        <a class="more" href="{{ '/news/' | relative_url }}">all news →</a>
      </div>
      {% include clean/news.liquid limit=page.announcements.limit %}
    </section>
  {% endif %}

  {% if page.selected_papers %}
    <section class="block" id="pubs">
      <div class="sec-head">
        <h2>Selected publications</h2>
        <a class="more" href="{{ '/publications/' | relative_url }}">all publications →</a>
      </div>
      <div class="publications">
        {% bibliography --group_by none --query @*[selected=true]* %}
      </div>
    </section>
  {% endif %}
</main>
