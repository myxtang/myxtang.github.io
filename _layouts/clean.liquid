<!doctype html>
<html lang="{{ site.lang }}" data-theme="dark">
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include metadata.liquid %}
    <!-- Theme: dark unless the visitor picked light with the toggle. Set before first paint. -->
    <script>
      (function () {
        var t = null;
        try {
          t = localStorage.getItem('theme');
        } catch (e) {}
        document.documentElement.setAttribute('data-theme', t === 'light' ? 'light' : 'dark');
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap"
    >
    <link rel="stylesheet" href="{{ '/assets/css/clean.css' | relative_url | bust_file_cache }}">
    {% if site.icon.size <= 4 %}
      <link
        rel="shortcut icon"
        href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{{ site.icon }}</text></svg>"
      >
    {% elsif site.icon != blank %}
      <link rel="shortcut icon" href="{{ site.icon | prepend: '/assets/img/' | relative_url | bust_file_cache }}">
    {% endif %}
    <link rel="canonical" href="{{ page.url | replace: 'index.html', '' | absolute_url }}">
  </head>

  <body>
    {% capture author_name %}{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}{% endcapture %}
    {% assign nav_pages = site.pages | where: 'nav', true | sort: 'nav_order' %}
    <header class="nav">
      <div class="wrap">
        <a class="me" href="{{ '/' | relative_url }}">{{ author_name }}</a>
        <nav aria-label="Main">
          <ul>
            <li>
              <a
                {% if page.url == '/' %}
                  class="on"
                {% endif %}
                href="{{ '/' | relative_url }}"
                >about</a
              >
            </li>
            {% for p in nav_pages %}
              <li>
                <a
                  {% if page.url == p.url %}
                    class="on"
                  {% endif %}
                  href="{{ p.url | relative_url }}"
                >
                  {{- p.title | downcase -}}
                </a>
              </li>
            {% endfor %}
            <li>
              <button id="theme-toggle" type="button" title="Switch between dark and light" aria-label="Switch between dark and light">
                <svg class="moon" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
                  <path fill="currentColor" d="M20.4 14.6A8.5 8.5 0 0 1 9.4 3.6a.75.75 0 0 0-.98-.93A10 10 0 1 0 21.33 15.6a.75.75 0 0 0-.93-.98Z" />
                </svg>
                <svg class="sun" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
                  <circle cx="12" cy="12" r="4.2" fill="currentColor" />
                  <path
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5.3 5.3l1.7 1.7M17 17l1.7 1.7M5.3 18.7 7 17M17 7l1.7-1.7"
                  />
                </svg>
              </button>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    {{ content }}

    <footer>
      <div class="wrap">&copy; {{ site.time | date: '%Y' }} {{ author_name }}</div>
    </footer>

    <script>
      document.getElementById('theme-toggle').addEventListener('click', function () {
        var t = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
        try {
          localStorage.setItem('theme', t);
        } catch (e) {}
      });
    </script>
  </body>
</html>
