{%- comment -%} Prints "2023-09" as "Sep 2023" and "2026" as "2026"; anything else is printed as given. {%- endcomment -%}
{%- assign ym_text = include.d | append: '' -%}
{%- assign ym_parts = ym_text | slice: 0, 7 | split: '-' -%}
{%- assign ym_names = 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec' | split: ',' -%}
{%- if ym_parts.size == 2 and ym_parts[0].size == 4 -%}
  {%- assign ym_index = ym_parts[1] | plus: 0 | minus: 1 -%}
  {{- ym_names[ym_index] }}
  {{ ym_parts[0] -}}
{%- else -%}
  {{- ym_text -}}
{%- endif -%}
